---
import { Image } from 'astro:assets';
import Concept from '../../layouts/Concept.astro';
import { getProjects, STATUS_LABEL } from '../../lib/projects';
import { profile } from '../../data/profile';
import { headline, workedWith, shortBio } from '../../data/pitch';

const projects = await getProjects();
const by = Object.fromEntries(projects.map((p) => [p.id, p]));
const featured = by['bioscape-phenology-explorer'];
const steps = [
  { p: by['hls-vi-pipeline'], what: 'Turn a decade of NASA HLS satellite imagery into clean vegetation time series' },
  { p: by['vi-phenology'], what: 'Build NetCDF phenology datacubes for every 30 m pixel — deliverable one, used as model inputs for BioSCape' },
  { p: featured, what: 'Deliverable two: a dashboard for scientists to explore the project’s regions and metrics' },
  { p: by['jetstream2-dashboard-deploy'], what: 'Keep it online on NSF’s Jetstream2 research cloud' },
];
const inFeature = new Set(steps.map((s) => s.p.id));
const rest = projects.filter((p) => !inFeature.has(p.id));
const year = (p: (typeof projects)[number]) => p.data.context?.match(/20\d\d/)?.[0] ?? '2026';
---

<Concept title="Flagship" bodyClass="flag">
  <header class="top">
    <a class="name" href="#">{profile.name}</a>
    <a class="mail" href={`mailto:${profile.email}`}>{profile.email}</a>
  </header>

  <section class="hello">
    <h1>{headline}</h1>
    <p>{profile.title}, {profile.location}. Currently a Research Collaborator with the National Science Foundation–funded GCE-SCIPE team at the University of Maryland Center for Environmental Science.</p>
  </section>

  <section class="feature">
    <p class="k">Flagship project</p>
    <h2>BioSCape Phenology Explorer</h2>
    <p class="lede">
      <a href="https://www.bioscape.io/">BioSCape</a> is a US–South Africa biodiversity project funded by NASA, South
      Africa’s NRF/SAEON and UNESCO, with scientists from around the world, studying the Greater Cape Floristic Region —
      one of the world’s 36 biodiversity hotspots. As a Research Collaborator with the National Science Foundation–funded GCE-SCIPE team at UMCES, working with Associate Research Scientist
      <a href="https://burchfisher.github.io/">G. Burch Fisher, Ph.D.</a>, I built the chain from raw satellite
      imagery to <strong>NetCDF datacubes of time-series phenology</strong> that were used as model inputs for the BioSCape project,
      and the dashboard that lets researchers explore them.
    </p>
    <div class="shot">
      {featured.data.cover && <Image src={featured.data.cover} alt={featured.data.coverAlt ?? ''} widths={[800, 1300, 1800]} sizes="(max-width: 1100px) 100vw, 1060px" />}
    </div>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li>
            <span class="i">{i + 1}</span>
            <b>{s.what}</b>
            <a href={`/projects/${s.p.id}/`}>{s.p.data.title} →</a>
          </li>
        ))
      }
    </ol>
    <p class="result">
      <b>Result:</b> phenology datacubes delivered and used as model inputs for BioSCape, a live dashboard for researchers, and
      every step open source and documented. <a href={`/projects/${featured.id}/`}>Read the full case study →</a>
    </p>
  </section>

  <section class="index">
    <h2>Other work</h2>
    <ul>
      {
        rest.map((p) => (
          <li>
            <a href={`/projects/${p.id}/`}>
              <span class="t">{p.data.title}</span>
              <span class="d">{p.data.tagline}</span>
              <span class="m">{p.data.status === 'research' ? STATUS_LABEL.research : year(p)}</span>
              {p.data.cover && <Image class="peek" src={p.data.cover} alt="" widths={[360]} sizes="240px" />}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="me">
    <div>
      <h2>About me</h2>
      <p>{shortBio}</p>
      <a href="/about/">Full background →</a>
    </div>
    <div class="with">
      <p class="k">Worked with and for</p>
      <ul>{workedWith.map((w) => <li>{w}</li>)}</ul>
    </div>
  </section>

  <footer class="bye">
    <h2>Let’s talk.</h2>
    <a href={`mailto:${profile.email}`}>{profile.email}</a>
    <a href={profile.github}>GitHub</a>
  </footer>
</Concept>

<style is:global>
  body.flag {
    margin: 0;
    background: #f7f6f2;
    color: #1a1d1b;
    font-family: 'Inter', system-ui, sans-serif;
    line-height: 1.6;
  }
  .flag section,
  .flag .top,
  .flag .bye {
    max-width: 1060px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
  .flag .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 72px;
  }
  .flag .name {
    font-weight: 700;
    color: inherit;
    text-decoration: none;
  }
  .flag .mail {
    color: #5b625f;
    font-size: 0.92rem;
  }
  .flag .hello {
    padding-top: clamp(40px, 8vw, 104px);
    padding-bottom: clamp(40px, 6vw, 72px);
  }
  .flag h1 {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 20ch;
    margin: 0 0 1rem;
  }
  .flag .hello p {
    color: #5b625f;
    font-size: 1.1rem;
    max-width: 56ch;
    margin: 0;
  }
  .flag .k {
    font: 600 0.75rem 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #b14a1c;
    margin: 0 0 0.75rem;
  }
  .flag h2 {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.15;
    margin: 0 0 1rem;
  }
  .flag .feature {
    background: #fff;
    border-radius: 20px;
    padding-top: clamp(28px, 5vw, 56px);
    padding-bottom: clamp(28px, 5vw, 56px);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 10px 40px rgba(0, 0, 0, 0.05);
  }
  .flag .lede {
    font-size: 1.1rem;
    color: #4b524f;
    max-width: 62ch;
    margin: 0 0 2rem;
  }
  .flag .shot img {
    width: 100%;
    border-radius: 12px;
    border: 1px solid #e7e4dc;
  }
  .flag .steps {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1.25rem;
  }
  .flag .steps li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .flag .steps .i {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #1f4d3a;
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .flag .steps b {
    font-weight: 600;
  }
  .flag .steps a {
    font-size: 0.9rem;
    color: #1f4d3a;
  }
  .flag .result {
    margin: 2rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid #ece9e1;
    color: #4b524f;
  }
  .flag .result b {
    color: #1a1d1b;
  }
  .flag .result a,
  .flag .lede a {
    color: #1f4d3a;
    font-weight: 600;
  }
  .flag .index {
    padding-top: clamp(56px, 8vw, 96px);
  }
  .flag .index ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .flag .index li a {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.1rem 0;
    border-top: 1px solid #e2ded5;
    color: inherit;
    text-decoration: none;
  }
  .flag .index li:last-child a {
    border-bottom: 1px solid #e2ded5;
  }
  .flag .t {
    font-weight: 600;
  }
  .flag .d {
    color: #5b625f;
    font-size: 0.95rem;
  }
  .flag .m {
    color: #8a8f8c;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .flag .index li a:hover .t {
    color: #b14a1c;
  }
  .flag .peek {
    position: absolute;
    right: 6rem;
    top: 50%;
    width: 220px;
    height: 150px;
    object-fit: cover;
    border-radius: 10px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
    opacity: 0;
    transform: translateY(-50%) scale(0.96);
    transition: all 0.2s;
    pointer-events: none;
    z-index: 2;
  }
  @media (hover: hover) {
    .flag .index li a:hover .peek {
      opacity: 1;
      transform: translateY(-50%) scale(1);
    }
  }
  @media (max-width: 700px) {
    .flag .index li a {
      grid-template-columns: 1fr auto;
      gap: 0.2rem 1rem;
    }
    .flag .d {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .flag .peek {
      display: none;
    }
  }
  .flag .me {
    padding-top: clamp(56px, 8vw, 96px);
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 3rem;
  }
  .flag .me p {
    font-size: 1.05rem;
    margin: 0 0 1rem;
  }
  .flag .me a {
    color: #1f4d3a;
    font-weight: 600;
  }
  .flag .with ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .flag .with li {
    padding: 0.5rem 0;
    border-top: 1px solid #e2ded5;
    font-weight: 600;
    font-size: 0.95rem;
  }
  @media (max-width: 760px) {
    .flag .me {
      grid-template-columns: 1fr;
    }
  }
  .flag .bye {
    padding-top: clamp(64px, 9vw, 112px);
    padding-bottom: 120px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem 2rem;
  }
  .flag .bye h2 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.2rem);
  }
  .flag .bye a {
    color: #1f4d3a;
    font-weight: 600;
    font-size: 1.1rem;
  }
</style>
