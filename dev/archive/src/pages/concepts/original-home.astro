---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import heroArt from '../../assets/projects/qgis-stacked-terrain-builder/hero.png';
import ProjectCard from '../../components/ProjectCard.astro';
import SkillMap from '../../components/SkillMap.astro';
import Contours from '../../components/Contours.astro';
import GalleryCard from '../../components/GalleryCard.astro';
import HomeScholar from '../../components/home/HomeScholar.astro';
import HomeGallery from '../../components/home/HomeGallery.astro';
import HomeCaseStudies from '../../components/home/HomeCaseStudies.astro';
import HomeJourney from '../../components/home/HomeJourney.astro';
import { getProjects } from '../../lib/projects';
import { GROUPS } from '../../data/taxonomy';
import { profile } from '../../data/profile';
import FeaturedMap from '../../components/FeaturedMap.astro';
import { featuredMaps } from '../../data/gallery';

const projects = await getProjects();
const inGroup = (g: string) => projects.filter((p) => p.data.group === g);
const research = inGroup('umces');
const qgis = inGroup('qgis');
const more = projects.filter((p) => p.data.group === 'webmap' || p.data.group === 'tools');

const flow = ['hls-vi-pipeline', 'vi-phenology', 'bioscape-phenology-explorer', 'jetstream2-dashboard-deploy']
  .map((id) => projects.find((p) => p.id === id)!)
  .filter(Boolean);
const flowNotes = ['Download, mask, index', 'Datacubes & metrics', 'Explore in a browser', 'Serve it on NSF cloud'];

const stats = [
  ['11', 'step NASA HLS processing pipeline'],
  ['19', 'per-pixel phenology metrics'],
  ['0.78', 'mean kappa vs. published MTBS fires'],
  ['1.8 cm', 'drone DSM in a 3D web map'],
];
---

<Base>
  <div class="home home-default">
  <section class="hero">
    <Contours class="contours" />
    <Image class="hero-art" src={heroArt} alt="" widths={[800, 1400]} sizes="(max-width: 900px) 100vw, 50vw" />
    <div class="wrap inner">
      <p class="eyebrow">{profile.title} · {profile.location}</p>
      <h1>Satellite, aerial and drone data, turned into tools that scientists use.</h1>
      <p class="lede">{profile.intro}</p>
      <div class="actions">
        <a class="btn" href="#research">See the work</a>
        <a class="btn ghost" href="/about/">About me</a>
      </div>
      <dl class="stats">
        {
          stats.map(([n, l]) => (
            <div>
              <dt>{n}</dt>
              <dd>{l}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section carto" id="cartography">
    <div class="wrap">
      <div class="split">
        <div>
          <p class="eyebrow">Cartography</p>
          <h2>Maps that make complex stories clear</h2>
          <p class="lede">
            From wildfires to earthquakes, I design maps anyone can read at a glance, and back them with careful,
            well-sourced data.
          </p>
        </div>
        <a class="btn" href="/maps/">View the map gallery →</a>
      </div>
      <div class="grid three">
        {featuredMaps.map((m) => <FeaturedMap map={m} compact />)}
      </div>
    </div>
  </section>

  <section class="section" id="research">
    <div class="wrap">
      <p class="eyebrow">Featured research</p>
      <h2>{GROUPS.umces.title}</h2>
      <p class="lede">{GROUPS.umces.blurb}</p>

      <ol class="flow" aria-label="Research workflow">
        {
          flow.map((p, i) => (
            <li>
              <span class="step">{String(i + 1).padStart(2, '0')}</span>
              <a href={`/projects/${p.id}/`}>{p.data.title}</a>
              <span class="note">{flowNotes[i]}</span>
            </li>
          ))
        }
      </ol>

      <div class="grid two">
        {research.slice(0, 2).map((p) => <ProjectCard project={p} large />)}
      </div>
      <div class="grid three">
        {research.slice(2).map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>


  <section class="section alt" id="more">
    <div class="wrap">
      <p class="eyebrow">Maps & cartography</p>
      <h2>{GROUPS.webmap.title}</h2>
      <p class="lede">{GROUPS.webmap.blurb}</p>
      <div class="grid three">
        {more.map((p) => <ProjectCard project={p} />)}
        <GalleryCard />
      </div>
    </div>
  </section>
  <section class="section" id="qgis">
    <div class="wrap">
      <p class="eyebrow">GIS tools</p>
      <h2>{GROUPS.qgis.title}</h2>
      <p class="lede">{GROUPS.qgis.blurb}</p>
      <div class="grid three">
        {qgis.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <section class="section alt" id="skills">
    <div class="wrap">
      <p class="eyebrow">Range</p>
      <h2>One portfolio, many skill sets</h2>
      <p class="lede">
        Each project draws on a different mix of skills. Here's where each one shows up.
      </p>
      <SkillMap projects={projects} />
    </div>
  </section>

  </div>
  <div class="home home-scholar"><HomeScholar projects={projects} /></div>
  <div class="home home-gallery"><HomeGallery projects={projects} /></div>
  <div class="home home-cases"><HomeCaseStudies projects={projects} /></div>
  <div class="home home-journey"><HomeJourney projects={projects} /></div>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(56px, 10vw, 120px) 0 clamp(48px, 7vw, 80px);
    border-bottom: 1px solid var(--line);
  }
  .hero :global(.contours) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .inner {
    position: relative;
  }
  .hero h1 {
    max-width: 20ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.75rem 0 2.5rem;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 1rem;
    margin: 0;
    max-width: 900px;
  }
  .stats div {
    border-left: 2px solid var(--accent);
    padding-left: 0.85rem;
  }
  .stats dt {
    font-family: var(--font-serif);
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .stats dd {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
  }
  .alt {
    background: var(--surface-2);
  }
  .grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .grid.two {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
  }
  .grid.three {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  .flow {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  .flow li {
    position: relative;
    padding: 1rem 1.2rem 1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    border-right: 1px solid var(--line);
  }
  .flow li:last-child {
    border-right: 0;
  }
  .step {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--rust);
  }
  .flow a {
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  .flow a:hover {
    color: var(--accent);
  }
  .note {
    font-size: 0.85rem;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .flow li {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .flow li:last-child {
      border-bottom: 0;
    }
  }
  .split {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }
</style>
