---
import { Image } from 'astro:assets';
import Contours from './Contours.astro';
import type { GalleryMap } from '../data/gallery';
import { fullRes } from '../lib/fullres';

interface Props {
  map: GalleryMap;
  compact?: boolean;
}
const { map, compact = false } = Astro.props;
const related = map.related ? [map.related].flat() : [];
const variants = !compact && map.variants?.length ? map.variants : undefined;
const full = map.full && !compact && !variants ? await fullRes(map.full) : undefined;
const variantFull = variants ? await Promise.all(variants.map((v) => (v.full ? fullRes(v.full) : undefined))) : [];
---

<figure class:list={['fmap', { compact, pending: !map.src }]} id={map.id}>
  {
    variants ? (
      <div class="pair">
        {variants.map((v, i) => (
          <div class="variant">
            <a class="img" href={v.src.src} aria-label={`Open full-size map: ${map.title}, ${v.label.toLowerCase()}`}>
              <Image src={v.src} alt={v.alt} widths={[600, 900, 1300, 1800]} sizes="(max-width: 760px) calc(100vw - 32px), 570px" />
            </a>
            <p class="vlabel">
              {v.label}
              {variantFull[i] && (
                <>
                  {' · '}
                  <a href={variantFull[i].href} download>Full resolution</a> ({variantFull[i].label})
                </>
              )}
            </p>
          </div>
        ))}
      </div>
    ) : map.src ? (
      <a class="img" href={map.src.src} aria-label={`Open full-size map: ${map.title}`}>
        <Image
          src={map.src}
          alt={map.alt ?? map.title}
          widths={compact ? [600, 720, 900, 1300] : [720, 1000, 1300, 1800, 2600]}
          sizes={compact ? '(max-width: 800px) calc(100vw - 32px), 560px' : '(max-width: 1200px) calc(100vw - 32px), 1160px'}
        />
      </a>
    ) : (
      <div class="img placeholder">
        <Contours class="bg" seed={map.id.length * 13} />
        <span>Map in preparation</span>
      </div>
    )
  }
  <figcaption>
    <h2>{map.title}</h2>
    {map.subtitle && <p class="sub">{map.subtitle}</p>}
    {!compact && map.story && <p class="story">{map.story}</p>}
    {variants && map.variantsNote && <p class="story">{map.variantsNote}</p>}
    {
      !compact && map.highlights && (
        <ul class="chips">
          {map.highlights.map((h) => (
            <li class="chip">{h}</li>
          ))}
        </ul>
      )
    }
    {(map.context || related.length > 0 || full) && (
      <p class="meta">
        {map.context}
        {!compact &&
          related.map((r) => (
            <>
              {' · '}
              <a href={r.href}>Related: {r.label}</a>
            </>
          ))}
        {full && (
          <>
            {' · '}
            <a href={full.href} download>Full resolution</a> ({full.label})
          </>
        )}
      </p>
    )}
  </figcaption>
</figure>

<style>
  .fmap {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .img {
    display: block;
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: var(--shadow);
  }
  .img :global(img) {
    width: 100%;
    height: auto;
    transition: transform 0.4s ease;
  }
  a.img:hover :global(img) {
    transform: scale(1.01);
  }
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  @media (max-width: 760px) {
    .pair {
      grid-template-columns: 1fr;
    }
  }
  .variant {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }
  .vlabel {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .placeholder {
    aspect-ratio: 3 / 2;
    display: grid;
    place-items: center;
    background: var(--surface-2);
    border-style: dashed;
    box-shadow: none;
  }
  .placeholder :global(.bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .placeholder span {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
  }
  h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  .compact h2 {
    font-size: 1.15rem;
  }
  .sub {
    margin: 0.15rem 0 0;
    color: var(--muted);
  }
  .story {
    margin: 0.75rem 0;
    max-width: 70ch;
    font-size: 1.05rem;
  }
  .meta {
    margin: 0.6rem 0 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .chips {
    margin-top: 0.25rem;
  }
</style>
