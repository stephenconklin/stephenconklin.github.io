---
import { logoRoads, logoLakes, animasLine } from '../data/durango-map';
import { profile } from '../data/profile';

const nav = [
  { href: '/projects/', label: 'Projects' },
  { href: '/maps/', label: 'Maps' },
  { href: '/how-i-work/', label: 'How I work' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${profile.name}, home`} title="Home">
      {/* A miniature of the Durango map behind the home page portrait: streets, lakes and the Animas River. */}
      <svg viewBox="0 0 400 400" width="30" height="30" aria-hidden="true">
        <defs>
          <clipPath id="brand-clip"><circle cx="200" cy="200" r="186" /></clipPath>
        </defs>
        <circle class="disc" cx="200" cy="200" r="186" />
        <g clip-path="url(#brand-clip)">
          <path class="roads" d={logoRoads} />
          <path class="lakes" d={logoLakes} />
          <path class="river" d={animasLine} />
        </g>
        <circle class="ring" cx="200" cy="200" r="186" />
      </svg>
      <span>{profile.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
        <li>
          <button class="theme" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 60px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.1rem;
    white-space: nowrap;
  }
  .brand svg {
    flex: none;
  }
  .brand .disc {
    fill: var(--surface);
  }
  .brand .ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 22;
  }
  .brand .roads {
    fill: none;
    stroke: var(--muted);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.85;
  }
  .brand .lakes {
    fill: var(--rust);
  }
  .brand .river {
    fill: none;
    stroke: var(--rust);
    stroke-width: 20;
    stroke-linecap: round;
  }
  ul {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 2.2vw, 1.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }
  nav a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .theme {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
  }
  @media (max-width: 760px) {
    .brand span {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .bar {
      flex-wrap: wrap;
      row-gap: 0.15rem;
      padding-top: 0.55rem;
      padding-bottom: 0.45rem;
    }
    .brand span {
      display: inline;
    }
    nav {
      width: 100%;
    }
    ul {
      justify-content: space-between;
      gap: 0.35rem;
    }
    nav a {
      white-space: nowrap;
      font-size: 0.9rem;
    }
  }
</style>
