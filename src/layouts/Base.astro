---
import '../styles/global.css';
import '../styles/variants.css';
import Annotator from '../components/Annotator.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import { DEFAULT_STYLE, STYLES } from '../data/styles';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  // Keep a page out of search results (e.g. test pages).
  noindex?: boolean;
  // Structured data (schema.org JSON-LD) describing the page for search engines.
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = profile.intro, image, noindex = false, schema } = Astro.props;
// The home page (no title) is named after the person and the site, the phrases people search for.
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.site}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Pages without their own image share a default preview card (public/og-default.png, 1200 x 630).
const ogImage = new URL(image ?? '/og-default.png', Astro.site).href;
const ogImageAlt = image
  ? `${title ?? profile.name}`
  : `${profile.name}, geospatial analyst, cartographer, and developer, with a line map of Durango, Colorado`;
// JSON-LD, with "<" escaped so the data can't close the script tag.
const jsonLd = schema ? JSON.stringify(schema).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang="en" data-style={DEFAULT_STYLE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <Analytics />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap"
    />
    <script is:inline define:vars={{ __STYLES__: Object.keys(STYLES), __DEFAULT__: DEFAULT_STYLE }}>
      // Preview another style with ?style=journey (for example). Fonts only the other styles use load on demand.
      window.__styleFonts = (st) => {
        if (st === __DEFAULT__ || document.getElementById('style-fonts')) return;
        const l = document.createElement('link');
        l.id = 'style-fonts';
        l.rel = 'stylesheet';
        l.href =
          'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Inter:wght@800&display=swap';
        document.head.appendChild(l);
      };
      try {
        const q = new URLSearchParams(location.search).get('style');
        // Only a ?style= in the URL changes the style; a style remembered from the old picker is cleared.
        localStorage.removeItem('style');
        const st = q;
        if (st && __STYLES__.includes(st)) {
          document.documentElement.dataset.style = st;
          window.__styleFonts(st);
        }
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {import.meta.env.DEV && <Annotator />}
  </body>
</html>
