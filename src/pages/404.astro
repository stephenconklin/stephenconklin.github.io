---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist." noindex>
  <div class="wrap page">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="lede">That address doesn't lead anywhere on this site. It may have moved, or there may be a typo.</p>
    <p class="links">
      <a class="btn" href="/">Home</a>
      <a class="btn ghost" href="/projects/">Projects</a>
      <a class="btn ghost" href="/maps/">Maps</a>
    </p>
  </div>
</Base>

<style>
  .page {
    padding-top: clamp(48px, 8vw, 96px);
    padding-bottom: clamp(64px, 10vw, 120px);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
</style>
