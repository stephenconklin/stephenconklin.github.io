---
import { graph, breadcrumbs } from '../../lib/schema';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';
import { GROUPS } from '../../data/taxonomy';
import { linkFisher } from '../../lib/people';

const projects = await getProjects();

// Sections on this page. Data tools share the plugins section; the other print and story maps live on the Maps page.
const sections = [
  { id: 'umces', groups: ['umces'], title: GROUPS.umces.title, blurb: GROUPS.umces.blurb },
  { id: 'qgis', groups: ['qgis', 'tools'], title: GROUPS.qgis.title, blurb: GROUPS.qgis.blurb },
  { id: 'webmap', groups: ['webmap'], title: GROUPS.webmap.title, blurb: GROUPS.webmap.blurb },
];
---

<Base title="Projects" description="Geospatial research, maps and cartography, and GIS plugins by Stephen Conklin." schema={graph(breadcrumbs([['Projects', '/projects/']]))}>
  <div class="wrap page">
    <p class="eyebrow">Projects</p>
    <h1>Work</h1>
    <p class="lede">
      Research pipelines, GIS plugins and tools, and maps, with more print and story maps in the <a href="/maps/">map gallery</a>.
    </p>
    {
      sections.map((s) => {
        const list = s.groups.flatMap((g) => projects.filter((p) => p.data.group === g));
        return (
          list.length > 0 && (
            <section id={s.id}>
              {/* Anchors for the other groups in this section, so project pages' back links still land here */}
              {s.groups.slice(1).map((g) => <span id={g} class="anchor" />)}
              <h2>{s.title}</h2>
              <p class="blurb" set:html={linkFisher(s.blurb)} />
              <div class="grid">
                {list.map((p) => (
                  <ProjectCard project={p} />
                ))}
              </div>
            </section>
          )
        );
      })
    }
  </div>
</Base>

<style>
  .page {
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: 72px;
  }
  section {
    margin-top: 3.5rem;
  }
  .blurb {
    color: var(--muted);
    max-width: 70ch;
  }
  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    margin-top: 1.5rem;
  }
</style>
